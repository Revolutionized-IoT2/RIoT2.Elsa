<Project>
  <!-- Central package versions (plan M8 step 2). Shared versions come from
       Revolutionized-IoT2/.github build/Directory.Packages.props.template. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a version below raise a transitive dependency of Elsa when an advisory needs it. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Elsa">
    <PackageVersion Include="Elsa" Version="3.9.0" />
    <PackageVersion Include="Elsa.Expressions.CSharp" Version="3.9.0" />
    <PackageVersion Include="Elsa.Expressions.JavaScript" Version="3.9.0" />
    <PackageVersion Include="Elsa.Expressions.Liquid" Version="3.9.0" />
    <PackageVersion Include="Elsa.Http" Version="3.9.0" />
    <PackageVersion Include="Elsa.Persistence.EFCore.Sqlite" Version="3.9.0" />
    <PackageVersion Include="Elsa.Retention" Version="3.9.0" />
    <PackageVersion Include="Elsa.Scheduling" Version="3.9.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="RIoT2.Core.Contracts" Version="2.3.0" />
    <PackageVersion Include="RIoT2.Core.Hosting" Version="2.3.0" />
    <PackageVersion Include="RIoT2.Core.Http" Version="2.3.0" />
    <PackageVersion Include="RIoT2.Core.Mqtt" Version="2.3.0" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
