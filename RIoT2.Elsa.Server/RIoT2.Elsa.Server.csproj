<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The remote workflow host (ADR 0016): the workflow engine library, the RIoT trigger endpoints, the
       workflow management API, gRPC and MQTT presence. No Elsa Studio, identity or REST API. -->
  <ItemGroup>
    <ProjectReference Include="..\RIoT2.Elsa.Workflows\RIoT2.Elsa.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- The contract and the MQTT client only: no device SDK, node runtime or Quartz (plan M1 step 4). -->
    <PackageReference Include="RIoT2.Core.Contracts" />
    <PackageReference Include="RIoT2.Core.Hosting" />
    <PackageReference Include="RIoT2.Core.Mqtt" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="RIoT\Protos\riot.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
