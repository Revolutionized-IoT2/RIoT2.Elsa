        "instructions": {
          "typeName": "String",
          "expression": {
            "type": "Literal",
            "value": "Plan the heat pump's target temperature for the next 24 hours, from now. Keep it between 18 and 22 °C. Heat more while electricity is cheap and before the coldest hours, and less while it is expensive, so the house stays comfortable (about 20 °C) for the least cost. The input has the electricity prices (c/kWh), the outside temperature forecast (°C) and the inside temperature. Answer with the steps: each step's time (ISO 8601, a price slot's start) and the temperature from then on. Use at most 12 steps."
          }
        },
        "inputData": {
          "typeName": "Object",
          "expression": {
            "type": "JavaScript",
            "value": "return {\n  now: new Date().toISOString(),\n  prices: getOutputFrom('Prices', 'Points'),\n  outsideTemperature: getOutputFrom('NextDayTemperature', 'Points'),\n  insideTemperature: getOutputFrom('InsideTemperature', 'DataObject')\n};"
          }
        },
        "responseFormat": {
          "typeName": "String",
          "expression": {
            "type": "Literal",
            "value": "Json"
          }
        },
        "jsonSchema": {
          "typeName": "String",
          "expression": {
            "type": "Literal",
            "value": "{\"type\":\"object\",\"properties\":{\"steps\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":12,\"items\":{\"type\":\"object\",\"properties\":{\"at\":{\"type\":\"string\"},\"value\":{\"type\":\"number\",\"minimum\":18,\"maximum\":22}},\"required\":[\"at\",\"value\"]}},\"reason\":{\"type\":\"string\"}},\"required\":[\"steps\"]}"
          }
